{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/__fixtures__/**"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "every weekend"
    ],
    "commitMessageAction": "Lock file maintenance",
    "automerge": false
  },
  "dependencyDashboardApproval": false,
  "semanticCommits": "enabled",
  "labels": [
    "dependencies",
    "version-bump-auto"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/envdrift/constants\\.json$/"
      ],
      "matchStrings": [
        "\"dotenvx_version\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "dotenvx/dotenvx",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/envdrift/constants\\.json$/"
      ],
      "matchStrings": [
        "\"sops_version\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "getsops/sops",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/envdrift/constants\\.json$/"
      ],
      "matchStrings": [
        "\"trivy_version\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "aquasecurity/trivy",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/envdrift/constants\\.json$/"
      ],
      "matchStrings": [
        "\"gitleaks_version\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/envdrift/constants\\.json$/"
      ],
      "matchStrings": [
        "\"trufflehog_version\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "trufflesecurity/trufflehog",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/envdrift/constants\\.json$/"
      ],
      "matchStrings": [
        "\"talisman_version\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "thoughtworks/talisman",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/envdrift/constants\\.json$/"
      ],
      "matchStrings": [
        "\"infisical_version\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "Infisical/cli",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/envdrift/constants\\.json$/"
      ],
      "matchStrings": [
        "\"detect_secrets_version\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "detect-secrets",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+version:\\s*(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Tool versions pinned as Makefile variables (e.g. markdownlint-cli2, invoked via npx inside the REQUIRED Lint check).",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+ *[:?]?= *(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "golangci-lint install command in the agent contributor docs. Keeps the doc copy in the SAME Renovate PR as the agent-ci.yml pin, so the two cannot drift the way copied pins otherwise do.",
      "managerFilePatterns": [
        "/^envdrift-agent/CONTRIBUTING\\.md$/"
      ],
      "matchStrings": [
        "go install github\\.com/golangci/golangci-lint/v2/cmd/golangci-lint@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "addLabels": [
        "minor-version-bump"
      ],
      "automerge": false
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major-version-bump"
      ],
      "automerge": false
    },
    {
      "description": "Bump the integration test stack images in tests/docker-compose.test.yml and .github/workflows/integration-tests.yml together (#500, #332); tests/unit/test_dev_stack_hygiene.py fails CI if they diverge.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "localstack/localstack",
        "hashicorp/vault",
        "nagyesta/lowkey-vault"
      ],
      "groupName": "integration test stack images"
    },
    {
      "description": "Pin LocalStack to the canonical zero-padded CalVer form (2026.07.1). Upstream publishes equivalent unpadded (2026.7.1) and truncated (2026.07, 2026) aliases that Renovate treats as EQUAL, so without this the literal can silently flip form between bumps. It also blocks a regression to the pre-2026.03 4.x line, which is tokenless but unmaintained.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "localstack/localstack"
      ],
      "allowedVersions": "/^\\d{4}\\.\\d{2}\\.\\d+$/"
    },
    {
      "description": "Track Go INDIRECT dependencies. Renovate's gomod extractor stamps enabled:false on every '// indirect' require (no Go 1.24+ tool directive here to re-enable them), so they vanish from updates AND from the dependency dashboard with no diagnostic - 12 of the agent's deps were invisible, including golang.org/x/sys with GO-2026-5024 package-imported in the shipped Windows binary.",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true,
      "groupName": "go indirect dependencies"
    }
  ],
  "prBodyTemplate": "{{{warnings}}}\n\n{{{table}}}\n\n---\n\n\ud83e\udd16 **Auto-generated version bump PR**\n\nThis PR was automatically created by Renovate to update dependency versions.\n\n- **Minor/Patch updates**: auto-merged by the `automerge-version-bump` workflow once all required CI checks pass \u2014 no human review\n- **Major updates**: require manual review and approval; never auto-merged\n\n{{{controls}}}\n",
  "schedule": [
    "every weekend"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ]
}
